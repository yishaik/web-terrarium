# Keep real values only in .env.local and in your Vercel project settings.
CRW_API_URL=https://api.fastcrw.com
CRW_API_KEY=
FIRECRAWL_API_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AGENT_WORKER_URL=
AGENT_WORKER_TOKEN=

# Vercel AI Gateway uses VERCEL_OIDC_TOKEN automatically in deployed functions.
# Set AI_GATEWAY_API_KEY only for local development or non-Vercel execution.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-luna

# Vercel Cron sends Authorization: Bearer <CRON_SECRET> when configured.
CRON_SECRET=
CONTINUOUS_RESEARCH_BATCH_SIZE=1
